# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/angel-one-documents

# Admin session (generate: openssl rand -base64 32)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# SMTP — TekSavvy Plesk mailbox (@angelonedocuments.com)
# Plesk → Mail → Email Addresses. SMTP must use an account WITH a mailbox (not forward-only).
# info@ may forward to sheila@ with "No mailbox" — authenticate as sheila@ (or give info@ its own mailbox).
# Host: webhost.teksavvy.com:587 + SMTP_TLS_SERVERNAME=webhost.teksavvy.com
SMTP_HOST=webhost.teksavvy.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_SERVERNAME=webhost.teksavvy.com
SMTP_USER=sheila@angelonedocuments.com
SMTP_PASS=
# SMTP_APP_PASS=

SMTP_FROM="Angel One Documents <info@angelonedocuments.com>"
OFFICE_EMAIL=info@angelonedocuments.com
SMTP_ACK_FROM="Angel One Documents <info@angelonedocuments.com>"

# Optional: recipient for `npm run smtp:verify` test send
# SMTP_TEST_TO=info@angelonedocuments.com

# Document storage: "local" or "s3"
STORAGE_DRIVER=local
# Local private path (not web-accessible)
STORAGE_LOCAL_PATH=.data/private-uploads

# S3-compatible storage (production)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
