# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/angel-one-documents

# Admin session (generate: openssl rand -base64 32)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# SMTP (office notifications & acknowledgements)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Angel One Documents <noreply@angelonedocuments.com>"

# Office email for incoming service requests (form submissions)
OFFICE_EMAIL=servicerequests@angelonedocuments.com

# Client thank-you emails (defaults to reception@angelonedocuments.com)
# SMTP_ACK_FROM="Angel One Documents <reception@angelonedocuments.com>"

# Document storage: "local" or "s3"
STORAGE_DRIVER=local
# Local private path (not web-accessible)
STORAGE_LOCAL_PATH=.data/private-uploads

# S3-compatible storage (production)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
